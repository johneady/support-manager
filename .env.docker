# Variables for the LOCAL docker-compose.yml stack only.
#
# Always: docker compose --env-file .env.docker up --build -d
#
# This is NOT the application's .env — it is Compose's variable file, and
# docker-compose.yml refuses to start without it. It is TRACKED deliberately:
# everything here is throwaway, and a fresh clone needs it to run the local
# stack at all.
#
# Never put a real credential in this file. Nothing here reaches production;
# Dokploy supplies production values from its own environment settings.

# Throwaway key for local verification. Not the production key, and never used
# to encrypt anything that outlives the local stack's volumes.
APP_KEY=base64:k3gZxHDPPEaqtQsyyhMAwqb61DyocKutyZZQOThXAO0=

# Sentinel: docker-compose.yml requires this, so forgetting --env-file fails
# loudly instead of silently reading the application's own .env.
DOCKER_LOCAL_STACK=1

# Host port for the local stack.
APP_PORT=8080
