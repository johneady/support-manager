includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    # The Pest test entry point (test()->...) proxies every Tests\TestCase
    # method through a runtime-bound closure that PHPStan cannot follow, so
    # analysing tests/ reports hundreds of false "undefined method" errors
    # until Pest ships a matching extension. Production code is analysed at
    # the strictest level instead.
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8
